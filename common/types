#include <string>
#include <vector>

const double HOURS_PER_MONTH = 730.0;               // quy uoc nhom: 1 thang = 730 gio
const double HOURS_PER_DAY   = 24.0;                // 1 ngay = 24 gio
const double MONTHS_PER_YEAR = 12.0;                // 1 nam = 12 thang
const std::string DEFAULT_REGION = "ap-southeast-1"; // vung mac dinh

// Loai tai nguyen
enum class ResourceType {
    Compute,
    Storage,
    Database
};

using Region = std::string;

// Kieu thoi gian tinh chi phi
enum class TimeUnit {
    Hour,
    Day,
    Month,
    Year
};

inline std::string timeUnitToString(TimeUnit t) {
    switch (t) {
        case TimeUnit::Hour:  return "gio";
        case TimeUnit::Day:   return "ngay";
        case TimeUnit::Month: return "thang";
        case TimeUnit::Year:  return "nam";
    }
    return "?";
}

inline std::string resourceTypeToString(ResourceType t) {
    switch (t) {
        case ResourceType::Compute:  return "Compute";
        case ResourceType::Storage:  return "Storage";
        case ResourceType::Database: return "Database";
    }
    return "Unknown";
}

// Thong so ky thuat cua 1 tai nguyen (adapter TV2 dung de tra gia)
struct Specification {
    int vcpu = 0;            // dung cho Compute
    int ramGB = 0;           // dung cho Compute
    int sizeGB = 0;          // dung cho Storage
    std::string engine;      // dung cho Database ("PostgreSQL" / "MySQL")
};

// Mot dong tai nguyen nguoi dung nhap vao tu UI (TV5 tao ra, TV3 doc)
struct ResourceInput {
    std::string type;        // "COMPUTE" | "STORAGE" | "DATABASE"
    int quantity = 1;        // so luong
    int vcpu = 0;            // chi dung cho COMPUTE
    int ramGB = 0;           // chi dung cho COMPUTE
    int usagePercent = 100;  // muc su dung CPU/RAM gia dinh (TV4 RightSizing can)
    int sizeGB = 0;          // chi dung cho STORAGE
    std::string engine;      // chi dung cho DATABASE
};

// Chi phi 1 thang cua 1 hang (TV3 tinh toan, TV5 hien thi)
struct ProviderCost {
    std::string provider;
    double compute = 0.0;
    double storage = 0.0;
    double database = 0.0;
    double total() const { return compute + storage + database; }
};

// Mot dong khuyen nghi toi uu (TV4 Strategy tao ra, TV5 hien thi)
struct Recommendation {
    std::string strategy;     // ten chien luoc
    std::string description;  // mo ta hanh dong toi uu
    double before = 0.0;      // chi phi truoc
    double after = 0.0;       // chi phi sau
    double saving() const { return before - after; }
    double percent() const { return before > 0.0 ? (saving() / before * 100.0) : 0.0; }
};

#include "ConcreteFactories.h"
#include <iostream>
#include <vector>

void demoFactory(CloudResourceFactory& factory, const std::string& providerName) {
    std::cout << "=== DEMO TAI NGUYEN: " << providerName << " ===\n";
    auto compute = factory.createCompute(4, 16);
    auto storage = factory.createStorage(500);
    auto database = factory.createDatabase("PostgreSQL");

    compute->display();
    storage->display();
    database->display();
    std::cout << std::endl;
}

int main() {
    std::cout << "========================================\n";
    std::cout << "   DEMO THANH VIEN 1: ABSTRACT FACTORY  \n";
    std::cout << "========================================\n\n";

    AWSResourceFactory awsFactory;
    GCPResourceFactory gcpFactory;
    AzureResourceFactory azureFactory;

    demoFactory(awsFactory, "AWS");
    demoFactory(gcpFactory, "GCP");
    demoFactory(azureFactory, "Azure");

    return 0;
}
